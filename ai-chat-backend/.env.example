# Required — copy this to .env and fill in your values

# ── AI ──────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey  (free, no billing needed)
AI_API_KEY=your_gemini_api_key_here

# ── Stripe ───────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Get from: https://dashboard.stripe.com/webhooks  (add endpoint: /api/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Create 3 products in Stripe Dashboard → Products, then paste Price IDs here:
# Starter  = 50 coins  = $1.99
STRIPE_PRICE_STARTER=price_...
# Standard = 200 coins = $4.99
STRIPE_PRICE_STANDARD=price_...
# Pro      = 600 coins = $9.99
STRIPE_PRICE_PRO=price_...

# ── App ──────────────────────────────────────────────────────────────
# The URL your frontend HTML is served from (no trailing slash)
# For local dev: http://localhost:3000
# For production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Port the backend runs on (default 3001)
PORT=3001
